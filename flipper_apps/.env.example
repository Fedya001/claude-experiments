# --- core ---
TELEGRAM_TOKEN=123456:ABC...            # from @BotFather
ALLOWED_USER_IDS=111111111              # your Telegram user id (comma-separated for several)
DATA_DIR=data                           # per-app state: data/<command>/
TZ=Europe/Berlin                        # "today" is evaluated in this time zone
LOG_LEVEL=INFO

# --- garmin_to_strava ---
# The bot's Strava API application, created once at https://www.strava.com/settings/api
# (see apps/garmin_to_strava/README.md). Users connect their own Strava account in the chat.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
