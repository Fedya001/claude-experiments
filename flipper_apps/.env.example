# --- core ---
TELEGRAM_TOKEN=123456:ABC...            # from @BotFather
ALLOWED_USER_IDS=111111111              # your Telegram user id (comma-separated for several)
DATA_DIR=data                           # per-app state: data/<command>/
TZ=Europe/Berlin                        # "today" is evaluated in this time zone
LOG_LEVEL=INFO

# --- garmin_to_strava ---
GARMIN_EMAIL=                           # optional: only used if cached tokens expire
GARMIN_PASSWORD=
STRAVA_CLIENT_ID=                       # https://www.strava.com/settings/api
STRAVA_CLIENT_SECRET=
